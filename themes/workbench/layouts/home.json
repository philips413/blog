{{- $items := slice -}}
{{- range (where site.RegularPages "Section" "post").ByDate.Reverse -}}
{{- $items = $items | append (dict
  "t" .Title
  "u" .RelPermalink
  "d" (.Date.Format "2006.01.02")
  "c" (delimit (.Params.categories | default slice) ", ")
  "g" (.Params.tags | default slice)
  "s" (.Plain | strings.TrimSpace)
) -}}
{{- end -}}
{{- $items | jsonify -}}
